# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Boleh publishable key baru (sb_publishable_...) ATAU anon key lama.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Cloudflare Turnstile (hanya jika CAPTCHA di Supabase Auth diaktifkan) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Web Push (npm run vapid) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:kamu@example.com

# --- HANYA server (jangan pakai prefix NEXT_PUBLIC_, jangan di-commit) ---
# Dipakai /api/push/send untuk membaca langganan push semua peserta.
SUPABASE_SECRET_KEY=
